# Staging 환경 (테스트 서버)
ENVIRONMENT=staging
DEMO_MODE=false
DATABASE_URL=postgresql+asyncpg://eia_user:${POSTGRES_PASSWORD}@db:5432/eia_prescreen
BACKEND_CORS_ORIGINS=["https://staging.eia-prescreen.example.com"]
NEXT_PUBLIC_API_URL=https://staging.eia-prescreen.example.com/api
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
DATA_GO_KR_API_KEY=${DATA_GO_KR_API_KEY}
LOG_LEVEL=INFO
DEBUG=false
SECRET_KEY=${SECRET_KEY}

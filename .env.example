# ──────────────────────────────────────
# EIA Pre-Screen — 환경 변수
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ──────────────────────────────────────

# ── Database ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eia_prescreen
POSTGRES_USER=eia_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change_me_in_production

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# ── LLM ──
# gemini (무료) 또는 openrouter (DeepSeek V3)
LLM_PROVIDER=gemini
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter (대안): https://openrouter.ai/
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-chat

# ── 공공데이터 API 키 ──
# 공공데이터포털: https://www.data.go.kr/
DATA_GO_KR_API_KEY=
# V-world: https://www.vworld.kr/
VWORLD_API_KEY=
# 에어코리아: https://www.airkorea.or.kr/
AIRKOREA_API_KEY=
# EIASS: https://www.eiass.go.kr/
EIASS_API_KEY=
# 한국도로공사: https://data.ex.co.kr/
DATA_EX_API_KEY=
# 국립해양조사원: https://www.khoa.go.kr/
KHOA_API_KEY=
# 폐기물 통계: http://www.recycling-info.or.kr/
WASTE_API_KEY=
WASTE_API_USERID=

# ── EIASS 로그인 (평가서 크롤링용) ──
# 회원가입: https://www.eiass.go.kr (무료)
EIASS_ID=
EIASS_PW=

# ── RAG 설정 ──
RAG_EMBED_MODEL=jhgan/ko-sroberta-multitask

# ── 캐시 설정 ──
CACHE_DIR=./data/snapshots
CACHE_TTL_HOURS=24
DEMO_MODE=true

# ── 데모 모드 ──
# true: 커넥터 오류 무시 + 빈 데이터 반환 (When true, suppresses connector errors and returns empty data instead of failing)
# false: 실제 API 호출 (API 키 필요)
